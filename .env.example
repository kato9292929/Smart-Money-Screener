# Nansen API credentials
NANSEN_API_KEY=your_nansen_api_key_here

# Wallet address to receive x402 payments (Base USDC)
PAYMENT_RECIPIENT_ADDRESS=0xYourBaseWalletAddressHere

# Optional: Custom facilitator URL (defaults to Coinbase CDP facilitator)
# X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v1/x402/facilitator
