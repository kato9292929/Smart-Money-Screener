# ── Nansen API ───────────────────────────────────────────────
NANSEN_API_KEY=your_nansen_api_key_here

# ── x402 v2: CDP API keys (production facilitator) ───────────
# Obtain from https://portal.cdp.coinbase.com/
CDP_API_KEY_ID=         # UUID format: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CDP_API_KEY_SECRET=     # base64 format (ends with ==)

# ── Facilitator URL ───────────────────────────────────────────
FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402

# ── Payment recipient wallet (Base mainnet) ───────────────────
WALLET_ADDRESS=0xYourBaseWalletAddressHere
