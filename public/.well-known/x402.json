{
  "version": "1",
  "name": "Smart Money Screener",
  "description": "Real-time smart money net-flow screener for Solana and Base tokens, powered by Nansen.",
  "icon": "https://smart-money-screener.vercel.app/icon.png",
  "endpoints": [
    {
      "path": "/api/screener/smart-money",
      "method": "GET",
      "description": "Returns top tokens by smart money net flow over the last 24 hours on Solana and Base.",
      "payment": {
        "price": "$0.05",
        "network": "base",
        "asset": "USDC"
      },
      "response": {
        "schema": {
          "type": "object",
          "properties": {
            "timestamp": { "type": "string", "format": "date-time" },
            "total_scanned": { "type": "integer" },
            "tokens": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "symbol": { "type": "string" },
                  "chain": { "type": "string", "enum": ["solana", "base"] },
                  "smart_money_wallets": { "type": "number" },
                  "net_flow_usd": { "type": "number" },
                  "unique_wallets": { "type": "number" },
                  "score": { "type": "number" },
                  "nansen_url": { "type": "string", "format": "uri" }
                }
              }
            }
          }
        }
      }
    }
  ],
  "contact": {
    "url": "https://github.com/kato9292929/Smart-Money-Screener"
  }
}
